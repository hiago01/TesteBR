+/* =============================================================================== */
+// sortLODs (libGTASA 0x4f5104, comparador do qsort de CRenderer::RenderEverythingBarRoads).
+// O original le  entidade->rwObject -> atomic -> geometria(+0x30) -> dados(+0x98) -> ArrayState*(+0x5c)  e chama
+// emu_ArraysGetID(ArrayState*) (= [ArrayState+0x30]) SEM testar o ArrayState. Esse ponteiro so existe depois que a geometria foi
+// desenhada/instanciada pela 1a vez; um LOD (ou qualquer "big building") recem-carregado ainda nao tem => SIGSEGV 'Fault address 0x30'
+// (libGTASA+0x250610). Aqui o mesmo calculo com todos os ponteiros checados (chave 0 enquanto nao existir). Mesma ordem: id decrescente.
+static uint64_t SortLODKey(void* ent)
+{
+	if (!ent) return 0;
+	uint8_t* rw = *(uint8_t**)((uint8_t*)ent + 0x20);
+	if (!rw) return 0;
+	RpAtomic* at = (rw[0] == 1) ? (RpAtomic*)rw : GetFirstAtomic((RpClump*)rw);
+	if (!at) return 0;
+	uint8_t* geom = *(uint8_t**)((uint8_t*)at + 0x30);
+	if (!geom) return 0;
+	uint8_t* dat = *(uint8_t**)(geom + 0x98);
+	if (!dat) return 0;
+	uint64_t st = 0; memcpy(&st, dat + 0x5c, sizeof(st));
+	if (!st) return 0;
+	return *(uint64_t*)(st + 0x30);
+}
+int (*sortLODs_orig)(const void*, const void*) = nullptr;
+int sortLODs_hook(const void* a, const void* b)
+{
+	static bool s_said = false; if (!s_said) { s_said = true; FLog("[CRASHFIX] sortLODs: hook em uso"); }
+	const uint64_t ka = SortLODKey(*(void* const*)a), kb = SortLODKey(*(void* const*)b);
+	return ka < kb ? 1 : (ka > kb ? -1 : 0);
+}
+
 void InstallCrashFixHooks()
 {
+	{   // sortLODs: endereco fixo da libGTASA deste projeto (_Z8sortLODsPKvS0_ = +0x4f5104); o resultado vai para o log
+		void* h = shadowhook_hook_func_addr((void*)(g_libGTASA + 0x4f5104), (void*)&sortLODs_hook, (void**)&sortLODs_orig);
+		FLog("[CRASHFIX] sortLODs (LOD sem ArrayState): hook %s", h ? "OK" : "ERRO (o crash em emu_ArraysGetID continua)");
+	}
 	// some crashfixes
 	CHook::InstallPLT(g_libGTASA + 0x66F5AC, (uintptr_t)CCustomRoadsignMgr_RenderRoadsignAtomic_hook, (uintptr_t*)&CCustomRoadsignMgr_RenderRoadsignAtomic);
 	CHook::InstallPLT(g_libGTASA + 0x67332C, (uintptr_t)_RwTextureDestroy_hook, (uintptr_t*)&_RwTextureDestroy);

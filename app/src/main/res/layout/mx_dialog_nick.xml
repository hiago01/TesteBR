<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/mx_bg_panel"
    android:orientation="vertical"
    android:paddingLeft="22dp"
    android:paddingTop="18dp"
    android:paddingRight="22dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/mx_nick_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/mx_nick_title_first"
        android:textColor="@color/mx_text"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/mx_nick_msg"
        android:textColor="@color/mx_text_dim"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/mx_nick_input"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/mx_bg_input"
        android:gravity="center"
        android:hint="@string/mx_nick_hint"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textVisiblePassword|textNoSuggestions"
        android:maxLength="20"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/mx_text"
        android:textColorHint="@color/gray"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/mx_nick_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:minHeight="16dp"
        android:textColor="@color/mx_offline"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/mx_nick_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/mx_btn_secondary"
            android:text="@string/mx_nick_cancel"
            android:textColor="@color/mx_text"
            android:textSize="14sp" />

        <Button
            android:id="@+id/mx_nick_ok"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/mx_btn_primary"
            android:text="@string/mx_nick_ok"
            android:textColor="@color/mx_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

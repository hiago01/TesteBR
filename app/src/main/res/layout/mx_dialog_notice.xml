<?xml version="1.0" encoding="utf-8"?>
<!-- Aviso generico do launcher (limpeza do cliente antigo, permissao para instalar o APK). Visual azul, com barra de progresso opcional. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/mx_app_card_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="22dp"
    android:paddingTop="18dp"
    android:paddingRight="22dp"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/mx_nt_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null"
        android:src="@drawable/mx_ic_bell" />

    <TextView
        android:id="@+id/mx_nt_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/mx_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/mx_nt_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textColor="#E6EAF5"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/mx_nt_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="14dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/mx_nt_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/mx_app_btn"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/mx_nt_btn_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mx_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

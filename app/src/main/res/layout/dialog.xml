<?xml version="1.0" encoding="utf-8"?>
<!-- Dialogo do jogo (SA-MP) no visual Maximo RP. Os ids sao usados por DialogManager.java: NAO renomear.
     Unidades em px na base 1920x1080 (Util.scaleViewAndChildren escala tudo). -->
<androidx.constraintlayout.widget.ConstraintLayout
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#66020814"
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto">

	<androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/dialog"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center"
		android:background="@drawable/ic_dialog_bg"
		android:visibility="visible"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent">

		<!-- ===== Cabecalho: logo | icone + titulo/subtitulo | fechar ===== -->
		<androidx.constraintlayout.widget.ConstraintLayout
			android:id="@+id/dialog_header"
			android:layout_width="0.0dip"
			android:layout_height="wrap_content"
			android:background="@drawable/mx_dlg_header_bg"
			android:paddingStart="40.0px"
			android:paddingTop="22.0px"
			android:paddingEnd="40.0px"
			android:paddingBottom="22.0px"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="parent">

			<ImageView
				android:id="@+id/dialog_logo"
				android:layout_width="210.0px"
				android:layout_height="114.0px"
				android:importantForAccessibility="no"
				android:scaleType="fitCenter"
				android:src="@drawable/maximo_logo"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent" />

			<View
				android:id="@+id/dialog_header_divider"
				android:layout_width="3.0px"
				android:layout_height="84.0px"
				android:layout_marginStart="32.0px"
				android:background="#662B8BFF"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintStart_toEndOf="@+id/dialog_logo"
				app:layout_constraintTop_toTopOf="parent" />

			<ImageView
				android:id="@+id/dialog_header_icon"
				android:layout_width="68.0px"
				android:layout_height="68.0px"
				android:layout_marginStart="32.0px"
				android:importantForAccessibility="no"
				android:src="@drawable/mx_ic_person"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintStart_toEndOf="@+id/dialog_header_divider"
				app:layout_constraintTop_toTopOf="parent"
				app:tint="#FF35C2FF" />

			<TextView
				android:id="@+id/dialog_caption"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="24.0px"
				android:layout_marginEnd="24.0px"
				android:fontFamily="@font/montserrat_bold"
				android:lines="1"
				android:maxLines="1"
				android:singleLine="true"
				android:text="Caption"
				android:textColor="#ffffffff"
				android:textSize="54.0px"
				app:layout_constraintBottom_toTopOf="@+id/dialog_subtitle"
				app:layout_constraintEnd_toStartOf="@+id/dialog_close"
				app:layout_constraintHorizontal_bias="0.0"
				app:layout_constraintStart_toEndOf="@+id/dialog_header_icon"
				app:layout_constraintTop_toTopOf="parent"
				app:layout_constraintVertical_chainStyle="packed" />

			<TextView
				android:id="@+id/dialog_subtitle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="24.0px"
				android:layout_marginEnd="24.0px"
				android:fontFamily="@font/montserrat_medium"
				android:lines="1"
				android:maxLines="1"
				android:singleLine="true"
				android:text=""
				android:textColor="#ffe6f0ff"
				android:textSize="30.0px"
				android:visibility="gone"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintEnd_toStartOf="@+id/dialog_close"
				app:layout_constraintHorizontal_bias="0.0"
				app:layout_constraintStart_toEndOf="@+id/dialog_header_icon"
				app:layout_constraintTop_toBottomOf="@+id/dialog_caption" />

			<ImageView
				android:id="@+id/dialog_close"
				android:layout_width="64.0px"
				android:layout_height="64.0px"
				android:importantForAccessibility="no"
				android:padding="14.0px"
				android:src="@drawable/mx_ic_close"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="parent" />

		</androidx.constraintlayout.widget.ConstraintLayout>

		<!-- ===== Corpo ===== -->
		<androidx.constraintlayout.widget.ConstraintLayout
			android:id="@+id/dialog_body"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="48.0px"
			android:layout_marginTop="36.0px"
			android:layout_marginEnd="48.0px"
			android:layout_marginBottom="44.0px"
			android:visibility="visible"
			app:layout_constraintBottom_toBottomOf="parent"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintHeight_max="760.0px"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@+id/dialog_header">

			<View
				android:id="@+id/dialog_top_anchor"
				android:layout_width="1.0px"
				android:layout_height="0.0px"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent" />

			<!-- cartao de texto (info) -->
			<ScrollView
				android:id="@+id/dialog_text_layout"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="28.0px"
				android:background="@drawable/mx_dlg_card_bg"
				android:minWidth="1000.0px"
				android:paddingStart="32.0px"
				android:paddingTop="26.0px"
				android:paddingEnd="32.0px"
				android:paddingBottom="26.0px"
				android:scrollbars="none"
				android:visibility="gone"
				app:layout_constraintBottom_toTopOf="@+id/dialog_buttons"
				app:layout_constraintHeight_max="560.0px"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@+id/dialog_top_anchor"
				app:layout_constraintVertical_bias="0.0">

				<LinearLayout
					android:layout_width="fill_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:id="@+id/dialog_info_icon"
						android:layout_width="64.0px"
						android:layout_height="64.0px"
						android:layout_marginEnd="28.0px"
						android:importantForAccessibility="no"
						android:src="@drawable/mx_ic_info"
						app:tint="#FF35C2FF" />

					<TextView
						android:id="@+id/dialog_text"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:fontFamily="@font/montserrat_medium"
						android:lineSpacingExtra="6.0px"
						android:text="Text"
						android:textColor="#ffffffff"
						android:textSize="30.0px" />

				</LinearLayout>

			</ScrollView>

			<!-- campo de texto / senha -->
			<androidx.constraintlayout.widget.ConstraintLayout
				android:id="@+id/dialog_input_layout"
				android:layout_width="0.0dip"
				android:layout_height="wrap_content"
				android:layout_marginBottom="32.0px"
				android:background="@drawable/ic_dialog_input_bg"
				android:visibility="visible"
				app:layout_constraintBottom_toTopOf="@+id/dialog_buttons"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintHorizontal_bias="0.0"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@+id/dialog_text_layout">

				<ImageView
					android:id="@+id/dialog_input_prompt"
					android:layout_width="52.0px"
					android:layout_height="52.0px"
					android:layout_marginStart="26.0px"
					android:importantForAccessibility="no"
					android:src="@drawable/mx_ic_prompt"
					app:layout_constraintBottom_toBottomOf="parent"
					app:layout_constraintStart_toStartOf="parent"
					app:layout_constraintTop_toTopOf="parent" />

				<ImageView
					android:id="@+id/dialog_input_keyboard"
					android:layout_width="60.0px"
					android:layout_height="60.0px"
					android:layout_marginEnd="28.0px"
					android:importantForAccessibility="no"
					android:src="@drawable/mx_ic_keyboard"
					app:layout_constraintBottom_toBottomOf="parent"
					app:layout_constraintEnd_toEndOf="parent"
					app:layout_constraintTop_toTopOf="parent" />

				<EditText
					android:id="@+id/dialog_input"
					android:layout_width="0.0dip"
					android:layout_height="wrap_content"
					android:background="@android:color/transparent"
					android:fontFamily="@font/montserrat_medium"
					android:hint="Clique para digitar..."
					android:imeOptions="flagNoExtractUi"
					android:inputType="textShortMessage"
					android:lines="1"
					android:maxLines="1"
					android:paddingStart="16.0px"
					android:paddingTop="30.0px"
					android:paddingEnd="16.0px"
					android:paddingBottom="30.0px"
					android:singleLine="true"
					android:textColor="#ffffffff"
					android:textColorHint="#8fa9d6ff"
					android:textSize="34.0px"
					app:layout_constraintBottom_toBottomOf="parent"
					app:layout_constraintEnd_toStartOf="@+id/dialog_input_keyboard"
					app:layout_constraintStart_toEndOf="@+id/dialog_input_prompt"
					app:layout_constraintTop_toTopOf="parent" />

			</androidx.constraintlayout.widget.ConstraintLayout>

			<androidx.constraintlayout.widget.ConstraintLayout
					android:id="@+id/dialog_list_layout"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="24.0px"
					android:layout_marginBottom="24.0px"
					android:minWidth="1000.0px"
					android:visibility="gone"
					app:layout_constraintBottom_toTopOf="@+id/dialog_buttons"
					app:layout_constraintEnd_toEndOf="parent"
					app:layout_constraintHeight_max="632.0px"
					app:layout_constraintHeight_min="632.0px"
					app:layout_constraintStart_toStartOf="parent"
					app:layout_constraintTop_toBottomOf="@+id/dialog_top_anchor">

					<androidx.constraintlayout.widget.ConstraintLayout
						android:id="@+id/dialog_tablist_row"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingStart="32.0px"
						android:paddingEnd="64.0px"
						android:paddingBottom="12.0px"
						android:visibility="visible"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintTop_toTopOf="parent">

						<TextView
							android:id="@+id/dialog_field1"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:fontFamily="@font/montserrat_bold"
							android:lines="1"
							android:maxLines="1"
							android:paddingEnd="20.0px"
							android:singleLine="true"
							android:text="Field1"
							android:textColor="#FF35C2FF"
							android:textSize="32.0px"
							app:layout_constraintStart_toStartOf="parent"
							app:layout_constraintTop_toTopOf="parent" />

						<TextView
							android:id="@+id/dialog_field2"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:fontFamily="@font/montserrat_bold"
							android:lines="1"
							android:maxLines="1"
							android:paddingEnd="20.0px"
							android:singleLine="true"
							android:text="Field2"
							android:textColor="#FF35C2FF"
							android:textSize="32.0px"
							app:layout_constraintStart_toEndOf="@+id/dialog_field1"
							app:layout_constraintTop_toTopOf="parent" />

						<TextView
							android:id="@+id/dialog_field3"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:fontFamily="@font/montserrat_bold"
							android:lines="1"
							android:maxLines="1"
							android:paddingEnd="20.0px"
							android:singleLine="true"
							android:text="Field2"
							android:textColor="#FF35C2FF"
							android:textSize="32.0px"
							app:layout_constraintStart_toEndOf="@+id/dialog_field2"
							app:layout_constraintTop_toTopOf="parent" />

						<TextView
							android:id="@+id/dialog_field4"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:fontFamily="@font/montserrat_bold"
							android:lines="1"
							android:maxLines="1"
							android:paddingEnd="20.0px"
							android:singleLine="true"
							android:text="Field4"
							android:textColor="#FF35C2FF"
							android:textSize="32.0px"
							app:layout_constraintStart_toEndOf="@+id/dialog_field3"
							app:layout_constraintTop_toTopOf="parent" />

					</androidx.constraintlayout.widget.ConstraintLayout>

					<androidx.constraintlayout.widget.ConstraintLayout
						android:id="@+id/dialog_list"
						android:layout_width="wrap_content"
						android:layout_height="0.0dip"
						android:background="@drawable/ic_dialog_list_bg"
						app:layout_constraintBottom_toBottomOf="parent"
						app:layout_constraintEnd_toEndOf="parent"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintTop_toBottomOf="@+id/dialog_tablist_row">

						<com.samp.mobile.launcher.util.CustomRecyclerView
							android:id="@+id/dialog_list_recycler"
							android:layout_width="0dp"
							android:layout_height="0dp"
							android:layout_marginStart="16.0px"
							android:layout_marginTop="16.0px"
							android:layout_marginEnd="16.0px"
							android:layout_marginBottom="16.0px"
							android:fadeScrollbars="false"
							android:scrollbarAlwaysDrawVerticalTrack="true"
							android:scrollbarSize="32.0px"
							android:scrollbarThumbVertical="@drawable/ic_dialog_scrollbar_thumb"
							android:scrollbarTrackVertical="@drawable/ic_dialog_scrollbar_track"
							android:scrollbars="vertical"
							android:verticalScrollbarPosition="right"
							android:visibility="visible"
							app:layout_constraintBottom_toBottomOf="parent"
							app:layout_constraintEnd_toEndOf="parent"
							app:layout_constraintStart_toStartOf="parent"
							app:layout_constraintTop_toTopOf="parent" />

					</androidx.constraintlayout.widget.ConstraintLayout>

				</androidx.constraintlayout.widget.ConstraintLayout>

			<!-- botoes -->
			<androidx.constraintlayout.widget.ConstraintLayout
				android:id="@+id/dialog_buttons"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="24.0px"
				android:layout_marginTop="24.0px"
				android:layout_marginEnd="24.0px"
				android:visibility="visible"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@+id/dialog_top_anchor"
				app:layout_constraintVertical_bias="1.0">

				<androidx.constraintlayout.widget.ConstraintLayout
					android:id="@+id/button_positive"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:background="@drawable/mx_dlg_btn_primary"
					android:minWidth="400.0px"
					app:layout_constraintBottom_toBottomOf="parent"
					app:layout_constraintStart_toStartOf="parent"
					app:layout_constraintTop_toTopOf="parent">

					<ImageView
						android:id="@+id/button_positive_icon"
						android:layout_width="48.0px"
						android:layout_height="48.0px"
						android:layout_marginStart="36.0px"
						android:importantForAccessibility="no"
						android:src="@drawable/mx_ic_check"
						app:layout_constraintBottom_toBottomOf="parent"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintTop_toTopOf="parent" />

					<TextView
						android:id="@+id/button_positive_text"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="18.0px"
						android:layout_marginTop="22.0px"
						android:layout_marginEnd="48.0px"
						android:layout_marginBottom="22.0px"
						android:fontFamily="@font/montserrat_bold"
						android:lines="1"
						android:maxLines="1"
						android:singleLine="true"
						android:text="Continuar"
						android:textColor="#ffffffff"
						android:textSize="36.0px"
						app:layout_constraintBottom_toBottomOf="parent"
						app:layout_constraintEnd_toEndOf="parent"
						app:layout_constraintStart_toEndOf="@+id/button_positive_icon"
						app:layout_constraintTop_toTopOf="parent" />

				</androidx.constraintlayout.widget.ConstraintLayout>

				<androidx.constraintlayout.widget.ConstraintLayout
					android:id="@+id/button_negative"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="28.0px"
					android:background="@drawable/ic_dialog_button_negative"
					android:minWidth="400.0px"
					android:visibility="visible"
					app:layout_constraintBottom_toBottomOf="parent"
					app:layout_constraintEnd_toEndOf="parent"
					app:layout_constraintStart_toEndOf="@+id/button_positive"
					app:layout_constraintTop_toTopOf="parent">

					<ImageView
						android:id="@+id/button_negative_icon"
						android:layout_width="48.0px"
						android:layout_height="48.0px"
						android:layout_marginStart="36.0px"
						android:importantForAccessibility="no"
						android:src="@drawable/mx_ic_exit"
						app:layout_constraintBottom_toBottomOf="parent"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintTop_toTopOf="parent" />

					<TextView
						android:id="@+id/button_negative_text"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="18.0px"
						android:layout_marginTop="22.0px"
						android:layout_marginEnd="48.0px"
						android:layout_marginBottom="22.0px"
						android:fontFamily="@font/montserrat_bold"
						android:lines="1"
						android:maxLines="1"
						android:singleLine="true"
						android:text="Cancelar"
						android:textColor="#ffffffff"
						android:textSize="36.0px"
						app:layout_constraintBottom_toBottomOf="parent"
						app:layout_constraintEnd_toEndOf="parent"
						app:layout_constraintStart_toEndOf="@+id/button_negative_icon"
						app:layout_constraintTop_toTopOf="parent" />

				</androidx.constraintlayout.widget.ConstraintLayout>

			</androidx.constraintlayout.widget.ConstraintLayout>

		</androidx.constraintlayout.widget.ConstraintLayout>
	</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/mx_bg_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="22dp"
        android:paddingRight="24dp"
        android:paddingBottom="20dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:src="@drawable/mx_ic_download" />

        <TextView
            android:id="@+id/mx_upd_req_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/mx_upd_req_title"
            android:textColor="@color/mx_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mx_upd_req_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/mx_upd_req_msg"
            android:textColor="@color/mx_text_dim"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/mx_upd_req_hint"
            android:textColor="@color/mx_warning"
            android:textSize="13sp" />

        <!-- Opcao 1: DOWNLOAD SEGURO (recomendado) -->
        <Button
            android:id="@+id/mx_upd_safe_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/mx_btn_primary"
            android:text="@string/mx_upd_safe_btn"
            android:textColor="@color/mx_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/mx_upd_safe_desc"
            android:textColor="@color/mx_text_dim"
            android:textSize="12sp" />

        <!-- Opcao 2: DOWNLOAD COMPLETO -->
        <Button
            android:id="@+id/mx_upd_full_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/mx_btn_secondary"
            android:text="@string/mx_upd_full_btn"
            android:textColor="@color/mx_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/mx_upd_full_desc"
            android:textColor="@color/mx_text_dim"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>

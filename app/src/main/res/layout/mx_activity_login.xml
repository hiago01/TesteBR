<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mx_login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mx_bg_panel">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="28dp"
            android:paddingTop="16dp"
            android:paddingRight="28dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/mx_login_avatar"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:contentDescription="@string/mx_login_avatar_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mx_avatar_default" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/mx_login_welcome"
                    android:textColor="@color/mx_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/mx_login_sub"
                    android:textColor="@color/mx_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/mx_login_tab_in"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/mx_login_tab_in"
                        android:textColor="@color/mx_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/mx_login_tab_up"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/mx_login_tab_up"
                        android:textColor="@color/mx_text_dim"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/mx_login_nick"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/mx_bg_input"
                    android:gravity="center"
                    android:hint="@string/mx_acc_nick_hint"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textVisiblePassword|textNoSuggestions"
                    android:maxLength="20"
                    android:singleLine="true"
                    android:textColor="@color/mx_text"
                    android:textColorHint="@color/mx_text_dim"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/mx_login_email"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/mx_bg_input"
                    android:gravity="center"
                    android:hint="@string/mx_login_email_hint"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:maxLength="100"
                    android:singleLine="true"
                    android:textColor="@color/mx_text"
                    android:textColorHint="@color/mx_text_dim"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/mx_login_pass"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/mx_bg_input"
                    android:gravity="center"
                    android:hint="@string/mx_acc_pass_hint"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:maxLength="32"
                    android:singleLine="true"
                    android:textColor="@color/mx_text"
                    android:textColorHint="@color/mx_text_dim"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/mx_login_pass2"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/mx_bg_input"
                    android:gravity="center"
                    android:hint="@string/mx_acc_pass2_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:maxLength="32"
                    android:singleLine="true"
                    android:textColor="@color/mx_text"
                    android:textColorHint="@color/mx_text_dim"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/mx_login_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:minHeight="28dp"
                    android:textColor="@color/mx_text_dim"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/mx_login_ok"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/mx_bg_btn_connect"
                    android:text="@string/mx_login_btn_in"
                    android:textColor="@color/mx_text"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>

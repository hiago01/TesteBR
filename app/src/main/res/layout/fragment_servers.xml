<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout_servers"
        android:layout_width="0dp"
        android:layout_height="@dimen/_32sdp"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tabBackground="@android:color/transparent"
        app:tabGravity="start"
        app:tabIndicatorColor="@color/mx_cyan"
        app:tabIndicatorGravity="bottom"
        app:tabIndicatorHeight="@dimen/_3sdp"
        app:tabMode="auto"
        app:tabRippleColor="@null"
        app:tabSelectedTextColor="@color/mx_cyan"
        app:tabTextAppearance="@style/tab_layout_title"
        app:tabTextColor="@color/mx_text_dim" />

    <com.samp.mobile.launcher.util.ViewPagerWithoutSwipe
        android:id="@+id/viewPager_servers"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout_servers" />
</androidx.constraintlayout.widget.ConstraintLayout>

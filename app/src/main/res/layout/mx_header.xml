<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="18dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/mx_logo"
        android:layout_width="86dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="Máximo RP"
        android:src="@drawable/maximo_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/mx_tag_divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#552B6BFF"
        app:layout_constraintBottom_toBottomOf="@+id/mx_logo"
        app:layout_constraintStart_toEndOf="@+id/mx_logo"
        app:layout_constraintTop_toTopOf="@+id/mx_logo" />

    <TextView
        android:id="@+id/mx_tag_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:fontFamily="@font/montserrat_bold"
        android:letterSpacing="0.25"
        android:text="@string/mx_tagline_top"
        android:textColor="#4DA3FF"
        android:textSize="10sp"
        app:layout_constraintBottom_toTopOf="@+id/mx_tag_bottom"
        app:layout_constraintStart_toEndOf="@+id/mx_tag_divider"
        app:layout_constraintTop_toTopOf="@+id/mx_logo"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/mx_tag_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:fontFamily="@font/montserrat_medium"
        android:letterSpacing="0.18"
        android:text="@string/mx_tagline_bottom"
        android:textColor="#B8C7E0"
        android:textSize="8sp"
        app:layout_constraintBottom_toBottomOf="@+id/mx_logo"
        app:layout_constraintStart_toEndOf="@+id/mx_tag_divider"
        app:layout_constraintTop_toBottomOf="@+id/mx_tag_top" />
</androidx.constraintlayout.widget.ConstraintLayout>

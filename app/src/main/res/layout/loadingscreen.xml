<?xml version="1.0" encoding="utf-8"?>
<!-- Segunda tela de loading (apos CONECTAR): arte Natal Maximo RP em tela cheia, barra azul com
     porcentagem real e a etapa atual. O card de musica ("Tocando agora") e outra view
     (game_music_card.xml) desenhada por cima. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/mx_loading_bg" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/mx_ld_g_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.842" />

    <LinearLayout
        android:id="@+id/mx_loading_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mx_ld_g_top"
        app:layout_constraintWidth_percent="0.42">

        <TextView
            android:id="@+id/mx_loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:letterSpacing="0.06"
            android:text="@string/mx_loading_title"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/_8sdp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.samp.mobile.game.ui.LoadingBarView
                android:id="@+id/progressBar2"
                android:layout_width="0dp"
                android:layout_height="@dimen/_8sdp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/mx_loading_pct"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="end"
                android:text="0%"
                android:textColor="#FFFFFFFF"
                android:textSize="@dimen/_8sdp" />
        </LinearLayout>

        <TextView
            android:id="@+id/mx_loading_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:fontFamily="@font/montserrat_regular"
            android:gravity="center"
            android:text="@string/mx_loading_step_start"
            android:textColor="#FFB8C6E0"
            android:textSize="@dimen/_7sdp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

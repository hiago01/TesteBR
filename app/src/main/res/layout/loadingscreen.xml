<?xml version="1.0" encoding="utf-8"?>
<!-- Segunda tela de loading (apos CONECTAR). Mesmo estilo: fundo preto, logo central e barra fina;
     agora com porcentagem real e etapa atual abaixo da barra. O grupo barra+textos fica centralizado
     no espaco abaixo do logo (como a barra original), sem sair da tela em telas baixas. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="@dimen/_120sdp"
        android:layout_height="@dimen/_120sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo" />

    <LinearLayout
        android:id="@+id/mx_loading_group"
        android:layout_width="@dimen/_250sdp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView3">

        <com.samp.mobile.game.ui.LoadingBarView
            android:id="@+id/progressBar2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_3sdp" />

        <TextView
            android:id="@+id/mx_loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:fontFamily="@font/montserrat_medium"
            android:text="@string/mx_loading_title"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_9sdp" />

        <TextView
            android:id="@+id/mx_loading_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:fontFamily="@font/montserrat_regular"
            android:gravity="center"
            android:text="@string/mx_loading_step_start"
            android:textColor="#8FA3C2"
            android:textSize="@dimen/_8sdp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

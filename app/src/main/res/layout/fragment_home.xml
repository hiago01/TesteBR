<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tv_home_welcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        android:fontFamily="@font/montserrat_black"
        android:text="@string/mx_home_welcome"
        android:textColor="@color/mx_text"
        android:textSize="@dimen/_18sdp"
        app:layout_constraintBottom_toTopOf="@+id/tv_home_sub"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_home_sub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        android:fontFamily="@font/montserrat_medium"
        android:text="@string/mx_home_sub"
        android:textColor="@color/mx_text_dim"
        android:textSize="@dimen/_10sdp"
        app:layout_constraintBottom_toTopOf="@+id/btn_home_play"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_home_welcome" />

    <Button
        android:id="@+id/btn_home_play"
        android:layout_width="@dimen/_150sdp"
        android:layout_height="@dimen/_34sdp"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:background="@drawable/mx_btn_primary"
        android:fontFamily="@font/montserrat_black"
        android:minHeight="0dp"
        android:text="@string/mx_menu_servers"
        android:textColor="@color/mx_text"
        android:textSize="@dimen/_11sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_home_sub" />
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/mx_bg_card"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/mx_news_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/mx_bg_notif_icon"
        android:importantForAccessibility="no"
        android:padding="6dp"
        android:src="@drawable/mx_ic_bell"
        app:tint="@color/mx_text" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mx_news_title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_bold"
            android:maxLines="1"
            android:textColor="@color/mx_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/mx_news_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_medium"
            android:maxLines="3"
            android:textColor="@color/mx_text_dim"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/mx_news_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserrat_medium"
            android:textColor="#6F86AD"
            android:textSize="8sp" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Cartao do servidor (aba Servidores). Todos os textos vem do SAMPServerInfo real. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/server_item_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/_4sdp"
    android:layout_marginTop="@dimen/_3sdp"
    android:layout_marginEnd="@dimen/_4sdp"
    android:layout_marginBottom="@dimen/_3sdp"
    android:background="@drawable/mx_card_bg"
    android:padding="@dimen/_10sdp">

    <ImageView
        android:id="@+id/card_lock"
        android:layout_width="@dimen/_14sdp"
        android:layout_height="@dimen/_14sdp"
        android:importantForAccessibility="no"
        android:tint="@color/mx_error"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/card_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/card_name"
        app:srcCompat="@drawable/mx_ic_lock" />

    <TextView
        android:id="@+id/card_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_2sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:ellipsize="end"
        android:fontFamily="@font/montserrat_black"
        android:maxLines="1"
        android:text="..."
        android:textColor="@color/mx_text"
        android:textSize="@dimen/_13sdp"
        app:layout_constraintEnd_toStartOf="@+id/card_status"
        app:layout_constraintStart_toEndOf="@+id/card_lock"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/card_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/mx_chip_loading"
        android:fontFamily="@font/montserrat_bold"
        android:paddingStart="@dimen/_10sdp"
        android:paddingTop="@dimen/_3sdp"
        android:paddingEnd="@dimen/_10sdp"
        android:paddingBottom="@dimen/_3sdp"
        android:text="@string/mx_status_checking"
        android:textColor="@color/mx_loading"
        android:textSize="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="@+id/card_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/card_name" />

    <LinearLayout
        android:id="@+id/card_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_name">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:orientation="vertical">
            <TextView style="@style/MxCardLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mx_label_mode" />
            <TextView android:id="@+id/card_mode" style="@style/MxCardValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mx_unknown" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:orientation="vertical">
            <TextView style="@style/MxCardLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mx_label_address" />
            <TextView android:id="@+id/card_address" style="@style/MxCardValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mx_unknown" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:orientation="vertical">
            <TextView style="@style/MxCardLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mx_label_port" />
            <TextView android:id="@+id/card_port" style="@style/MxCardValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mx_unknown" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:orientation="vertical">
            <TextView style="@style/MxCardLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mx_label_players" />
            <TextView android:id="@+id/card_players" style="@style/MxCardValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mx_unknown" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:orientation="vertical">
            <TextView style="@style/MxCardLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mx_label_ping" />
            <TextView android:id="@+id/card_ping" style="@style/MxCardValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mx_unknown" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/card_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_8sdp"
        android:fontFamily="@font/montserrat_medium"
        android:text="@string/mx_tap_to_retry"
        android:textColor="@color/mx_text_dim"
        android:textSize="@dimen/_8sdp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/card_connect"
        app:layout_constraintEnd_toStartOf="@+id/card_connect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/card_connect" />

    <Button
        android:id="@+id/card_connect"
        android:layout_width="@dimen/_120sdp"
        android:layout_height="@dimen/_32sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/mx_btn_primary"
        android:fontFamily="@font/montserrat_black"
        android:minHeight="0dp"
        android:text="@string/mx_connect"
        android:textColor="@color/mx_text"
        android:textSize="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_info" />
</androidx.constraintlayout.widget.ConstraintLayout>

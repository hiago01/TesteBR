<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="#33406080"/><corners android:radius="10dp"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><gradient android:angle="0" android:startColor="#FF0A4ED0" android:endColor="#FF1675DB"/><corners android:radius="10dp"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><gradient android:angle="0" android:startColor="#FF0B5BFF" android:endColor="#FF1E90FF"/><corners android:radius="10dp"/></shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:innerRadiusRatio="2.35" android:thicknessRatio="14" android:useLevel="false">
            <solid android:color="#26FFFFFF"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate android:fromDegrees="270" android:toDegrees="270" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="ring" android:innerRadiusRatio="2.35" android:thicknessRatio="14" android:useLevel="true">
                <gradient android:type="sweep" android:startColor="#FFFF4D5A" android:centerColor="#FFFFC95A" android:endColor="#FF3DE08A"/>
            </shape>
        </rotate>
    </item>
</layer-list>

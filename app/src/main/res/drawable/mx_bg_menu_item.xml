<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="#33FFC95A"/><corners android:radius="13dp"/></shape></item>
            <item android:bottom="1.5dp" android:left="1.5dp" android:right="1.5dp" android:top="1.5dp"><shape android:shape="rectangle"><gradient android:angle="0" android:startColor="#FFE63946" android:endColor="#FFB5121F"/><stroke android:width="1.2dp" android:color="#FFFFD27A"/><corners android:radius="11dp"/></shape></item>
        </layer-list>
    </item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="#33FFC95A"/><corners android:radius="11dp"/></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#14FFFFFF"/><corners android:radius="11dp"/></shape></item>
</selector>

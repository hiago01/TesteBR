<?xml version="1.0" encoding="utf-8"?>
<!-- Botoes do chat (v ^ /): azul-marinho com contorno azul neon (mesma paleta do HUD). Brilho = traco externo translucido. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="4dp" android:color="#772E96FF" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#FF2A6FE0" android:endColor="#FF123C9A" />
                    <stroke android:width="1.5dp" android:color="#FF9FD0FF" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="4dp" android:color="#552E96FF" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#FF0B2468" android:endColor="#FF061238" />
                    <stroke android:width="1.5dp" android:color="#FF2E96FF" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

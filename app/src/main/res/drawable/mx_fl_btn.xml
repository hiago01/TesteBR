<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#FF0A6B58" android:startColor="#FF12A67F" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#FF0E9A78" android:startColor="#FF2CE8B4" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>

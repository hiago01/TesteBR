<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mx_card_selected"/>
            <stroke android:width="1.5dp" android:color="@color/mx_accent"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mx_card"/>
            <stroke android:width="1dp" android:color="#552B6BFF"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
</selector>

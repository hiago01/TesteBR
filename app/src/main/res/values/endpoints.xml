<?xml version="1.0" encoding="utf-8"?>
<!--
  Endpoints do launcher (fonte unica). NAO espalhe URLs pelas classes: use AppEndpoints.java.

  Valores abaixo = PRODUCAO: HTTPS no dominio proprio (o Caddy serve a pasta do site direto com file_server).
  Veja LEIA-ME_LAUNCHER_FIX.md.
-->
<resources>
    <!-- Base do servidor HTTP do launcher, sem barra final. -->
    <string name="endpoint_base_url" translatable="false">https://maximoroleplay.com.br</string>
    <!-- JSON com o servidor exibido (estrutura documentada em docs/servers.example.json). -->
    <!-- JSON das noticias (aba Noticias). Formato em LEIA-ME_NOTICIAS_JSON.md. -->
    <string name="endpoint_news_path" translatable="false">/noticias.json</string>
    <string name="endpoint_servers_path" translatable="false">/servidores.json</string>
    <!-- JSON do atualizador (campos na raiz): version_code, url_launcher, launcher_sha256, launcher_size, url_cache_files. -->
    <string name="endpoint_maximo_config_path" translatable="false">/maximo_config.json</string>
    <!-- Lista de arquivos do jogo (gerada pelo painel do servidor; formato igual ao samp-mobile.shop/files.json).
         So e usada se o maximo_config.json vier sem url_cache_files. -->
    <string name="endpoint_files_list_path" translatable="false">/files_testes.json</string>
    <!-- Prefixo de download dos arquivos que vem SEM "url" na lista; recebe o "path" de cada item. -->
    <string name="endpoint_files_path" translatable="false">/filestestes/</string>
    <!-- true = gesto secreto da Splash: 4 toques ATIVAM o modo sem verificacao, 3 toques DESLIGAM (so vale na abertura atual; nunca fica gravado). false = desativado. -->
    <bool name="secret_gesture_enabled">true</bool>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Endpoints do launcher (fonte unica). NAO espalhe URLs pelas classes: use AppEndpoints.java.

  Valores abaixo = PRODUCAO: HTTPS no dominio proprio (o Caddy serve a pasta do site direto com file_server).
  Veja LEIA-ME_LAUNCHER_FIX.md.
-->
<resources>
    <!-- Base do servidor HTTP do launcher, sem barra final. -->
    <string name="endpoint_base_url" translatable="false">https://maximoroleplay.com.br</string>
    <!-- JSON com o servidor exibido (estrutura documentada em docs/servers.example.json). -->
    <!-- JSON das noticias (aba Noticias). Formato em LEIA-ME_NOTICIAS_JSON.md. -->
    <string name="endpoint_news_path" translatable="false">/noticias.json</string>
    <string name="endpoint_servers_path" translatable="false">/servers.json</string>
    <!-- JSON do atualizador (client_config) com version_code, url_launcher, url_cache_files. -->
    <string name="endpoint_client_config_path" translatable="false">/client_config.json</string>
    <!-- Prefixo de download dos arquivos do jogo; recebe o "path" de cada item de url_cache_files. -->
    <string name="endpoint_files_path" translatable="false">/filestestes/</string>
    <!-- JSON da pasta SAMP/ (gerado por gerar_samp_json.py a partir de C:\cache-server\SAMP). Os arquivos dela sao baixados em
         <base>/<path>, ex.: https://maximoroleplay.com.br/SAMP/dff/x.dff (a pasta cache-server/SAMP fica na raiz do servidor). -->
    <string name="endpoint_samp_json_path" translatable="false">/samp.json</string>
    <!-- true = na 1a abertura de cada APK novo (versionCode diferente) o launcher APAGA os arquivos dos clientes antigos em files/
         (menos configuracoes/favoritos/log/diag.ini) e instala tudo de novo pelo PRDownloader. false = nao apaga nada. -->
    <bool name="wipe_files_on_new_apk">true</bool>
    <!-- false = gesto secreto (4 toques na Splash) DESATIVADO: o launcher sempre verifica/baixa o cliente. true so em APK de teste. -->
    <bool name="secret_gesture_enabled">false</bool>
</resources>

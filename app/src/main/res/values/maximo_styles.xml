<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MxCardLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:textColor">@color/mx_text_dim</item>
        <item name="android:textSize">@dimen/_8sdp</item>
    </style>
    <style name="MxCardValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_1sdp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/mx_text</item>
        <item name="android:textSize">@dimen/_10sdp</item>
    </style>
</resources>

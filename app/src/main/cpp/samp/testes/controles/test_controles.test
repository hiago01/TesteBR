// Testes de PC da logica dos controles (controlmode_logic.h). Nao testa NDK/Android/aparelho.
#include "../../gui/samp_widgets/controlmode_logic.h"
#include <cstdio>
using namespace CtlLogic;
static int fails = 0, total = 0;
#define CHECK(c) do { total++; if (!(c)) { fails++; printf("FALHOU L%d: %s\n", __LINE__, #c); } } while (0)

int main()
{
	// --- modo / padrao classico ---
	CHECK(ModeFromString(nullptr) == Mode::Classic);
	CHECK(ModeFromString("") == Mode::Classic);
	CHECK(ModeFromString("lixo") == Mode::Classic);
	CHECK(ModeFromString("MODERNO") == Mode::Modern);
	CHECK(ModeFromString("classico") == Mode::Classic);
	CHECK(std::string(ModeToString(Mode::Modern)) == "moderno");
	CHECK(SectionFor("Jo ao") == "controles_Jo_ao");
	CHECK(SectionFor("") == "controles_jogador");
	CHECK(SectionFor(nullptr) == "controles_jogador");

	// --- config: clamp ---
	ModernConfig c; c.joyScale = 99; c.alpha = -1; c.deadzone = NAN; c.btnPos[0] = {5, -5}; c.Clamp();
	CHECK(c.joyScale == 1.6f); CHECK(c.alpha == 0.15f); CHECK(c.deadzone == 0.12f);
	CHECK(c.btnPos[0].x == 0.97f && c.btnPos[0].y == 0.05f);

	// --- analogico ---
	float x, y;
	StickAxes(0, 0, 100, 0.1f, 1, x, y); CHECK(x == 0 && y == 0);
	StickAxes(5, 0, 100, 0.1f, 1, x, y); CHECK(x == 0 && y == 0);               // dentro da zona morta
	StickAxes(100, 0, 100, 0.1f, 1, x, y); CHECK(std::fabs(x - 1) < 1e-5 && y == 0);
	StickAxes(500, 0, 100, 0.1f, 1, x, y); CHECK(std::fabs(x - 1) < 1e-5);      // satura
	StickAxes(55, 0, 100, 0.1f, 1, x, y); CHECK(x > 0.4f && x < 0.6f);          // proporcional
	float x1, y1, x2, y2;
	StickAxes(30, 0, 100, 0.1f, 1, x1, y1); StickAxes(60, 0, 100, 0.1f, 1, x2, y2); CHECK(x2 > x1);
	StickAxes(70, 70, 100, 0.1f, 1, x, y); CHECK(std::fabs(x - y) < 1e-5 && x > 0); // diagonal 45
	StickAxes(-70, -70, 100, 0.1f, 1, x, y); CHECK(x < 0 && y < 0);             // 360: outro quadrante
	StickAxes(50, 0, 100, 0.1f, 2, x1, y1); StickAxes(50, 0, 100, 0.1f, 1, x2, y2); CHECK(x1 > x2);   // sensibilidade
	StickAxes(1, 1, 0, 0.1f, 1, x, y); CHECK(x == 0 && y == 0);                 // maxDist invalido
	CHECK(ToPad(1.0f) == 127 && ToPad(-1.0f) == -127 && ToPad(5) == 127 && ToPad(0) == 0);

	// --- layout ---
	ModernConfig cfg; ModernController k; k.cfg = cfg; k.SetScreen(2400, 1080);
	CHECK(k.lay.base.cx < 2400 * 0.3f && k.lay.base.cy > 1080 * 0.5f);   // joystick embaixo a esquerda
	for (int i = 0; i < B_COUNT; i++) for (int j = i + 1; j < B_COUNT; j++)
	{
		const float dx = k.lay.btn[i].cx - k.lay.btn[j].cx, dy = k.lay.btn[i].cy - k.lay.btn[j].cy;
		CHECK(std::sqrt(dx * dx + dy * dy) > k.lay.btn[i].r + k.lay.btn[j].r);   // padrao: nada sobreposto
	}
	// retrato tambem cabe
	{ ModernController p; p.SetScreen(1080, 2400); for (int i = 0; i < B_COUNT; i++) CHECK(p.lay.btn[i].cx > 0 && p.lay.btn[i].cx < 1080); }

	// --- multitouch ---
	const CtlCircle J = k.lay.base, A = k.lay.btn[B_ATTACK], U = k.lay.btn[B_JUMP], R = k.lay.btn[B_RUN];
	CHECK(!k.OnTouch(2, 0, 1200, 100));                          // toque no vazio: nao e nosso (vai pro jogo/camera)
	CHECK(k.OnTouch(2, 1, J.cx, J.cy));                          // dedo 1 no joystick
	CHECK(k.StickDown());
	CHECK(k.OnTouch(2, 2, A.cx, A.cy));                          // dedo 2 no ataque (simultaneo)
	CHECK(k.OnTouch(2, 3, U.cx, U.cy));                          // dedo 3 no pulo
	{ Output o = k.Read(false); CHECK((o.held & (1u << B_ATTACK)) && (o.held & (1u << B_JUMP))); CHECK(!o.stickActive); }
	CHECK(k.OnTouch(3, 1, J.cx + J.r, J.cy));                    // joystick todo a direita
	{ Output o = k.Read(false); CHECK(o.lr == 127 && o.ud == 0 && o.stickActive); }
	CHECK(k.OnTouch(3, 1, J.cx, J.cy - J.r));                    // para cima -> ud negativo (frente)
	{ Output o = k.Read(false); CHECK(o.ud == -127 && o.lr == 0); }
	// dedo do ataque arrasta para fora: continua dono ate soltar
	CHECK(k.OnTouch(3, 2, 10, 10)); { Output o = k.Read(false); CHECK(o.held & (1u << B_ATTACK)); }
	CHECK(k.OnTouch(1, 2, 10, 10)); { Output o = k.Read(true); CHECK(!(o.held & (1u << B_ATTACK))); CHECK(o.releasedEdge & (1u << B_ATTACK)); CHECK(o.pressedEdge & (1u << B_ATTACK)); }
	{ Output o = k.Read(true); CHECK(o.pressedEdge == 0 && o.releasedEdge == 0); }     // bordas consumidas 1x
	// soltar o joystick volta ao centro; os outros dedos nao sao afetados
	CHECK(k.OnTouch(1, 1, 0, 0)); { Output o = k.Read(false); CHECK(o.lr == 0 && o.ud == 0 && !k.StickDown()); CHECK(o.held & (1u << B_JUMP)); }
	CHECK(!k.OnTouch(3, 7, 5, 5));                               // move de dedo desconhecido: nao e nosso
	CHECK(!k.OnTouch(1, 7, 5, 5));
	// um dedo nao pega dois controles / dois dedos no mesmo botao
	CHECK(k.OnTouch(2, 4, R.cx, R.cy)); CHECK(k.BtnFinger(B_RUN) == 4);
	CHECK(!k.OnTouch(2, 5, R.cx, R.cy) || k.BtnFinger(B_RUN) == 4);
	// CANCEL solta tudo
	k.CancelAll(); { Output o = k.Read(true); CHECK(o.held == 0 && !o.stickActive); CHECK(o.releasedEdge != 0); }
	// push repetido do mesmo dedo (POINTER_DOWN duplicado) nao troca de dono
	CHECK(k.OnTouch(2, 1, J.cx, J.cy)); CHECK(k.OnTouch(2, 1, A.cx, A.cy)); CHECK(!k.BtnDown(B_ATTACK));
	k.CancelAll();

	// --- botao desabilitado (microfone sem voz)
	{ ModernController m; m.SetScreen(2400, 1080); m.blockedMask = ((1u << B_COUNT) - 1u) & ~(1u << B_JUMP); const CtlCircle ac = m.lay.btn[B_ATTACK], jc = m.lay.btn[B_JUMP]; CHECK(!m.OnTouch(2, 1, ac.cx, ac.cy) && !m.BtnDown(B_ATTACK)); CHECK(m.OnTouch(2, 2, jc.cx, jc.cy) && m.BtnDown(B_JUMP)); m.blockedMask = 0; m.OnTouch(1, 2, 0, 0); CHECK(m.OnTouch(2, 1, ac.cx, ac.cy) && m.BtnDown(B_ATTACK)); }   // pulando/parede: tudo bloqueado menos PULO
	{ ModernController m; m.SetScreen(2400, 1080); m.disabledMask = 1u << B_RUN; const CtlCircle rc = m.lay.btn[B_RUN]; CHECK(!m.OnTouch(2, 1, rc.cx, rc.cy) && !m.BtnDown(B_RUN)); m.disabledMask = 0; CHECK(m.OnTouch(2, 1, rc.cx, rc.cy) && m.BtnDown(B_RUN)); }   // LOCK ligado esconde CORRER
	{ ModernController m; m.SetScreen(2400, 1080); m.disabledMask = 1u << B_MIC; const CtlCircle mc = m.lay.btn[B_MIC]; CHECK(!m.OnTouch(2, 1, mc.cx, mc.cy)); m.disabledMask = 0; CHECK(m.OnTouch(2, 1, mc.cx, mc.cy) && m.BtnDown(B_MIC)); }

	// --- zona morta configuravel no controlador ---
	{ ModernConfig d; d.deadzone = 0.3f; ModernController q; q.cfg = d; q.SetScreen(2400, 1080);
	  q.OnTouch(2, 1, q.lay.base.cx, q.lay.base.cy); q.OnTouch(3, 1, q.lay.base.cx + q.lay.maxDistPx * 0.2f, q.lay.base.cy);
	  CHECK(q.Read(false).lr == 0);
	  q.OnTouch(3, 1, q.lay.base.cx + q.lay.maxDistPx * 0.6f, q.lay.base.cy); CHECK(q.Read(false).lr > 0); }

	// --- edicao de posicoes ---
	{ ModernController e; e.SetScreen(2400, 1080); e.editing = true;
	  const CtlCircle a = e.lay.btn[B_ATTACK];
	  CHECK(e.OnTouch(2, 1, a.cx, a.cy)); CHECK(e.OnTouch(3, 1, 1200, 540)); CHECK(e.OnTouch(1, 1, 1200, 540));
	  CHECK(std::fabs(e.cfg.btnPos[B_ATTACK].x - 0.5f) < 1e-3 && std::fabs(e.cfg.btnPos[B_ATTACK].y - 0.5f) < 1e-3);
	  CHECK(e.Read(false).held == 0);                                // editar nao dispara gameplay
	  CHECK(e.OnTouch(2, 2, e.lay.base.cx, e.lay.base.cy)); CHECK(e.OnTouch(3, 2, 600, 700)); CHECK(e.OnTouch(1, 2, 600, 700));
	  CHECK(std::fabs(e.cfg.joyPos.x - 600.0f / 2400) < 1e-3); }

	// --- editor de HUD (painel no estilo da referencia) ---
	{
		const float W = 2400, Hh = 1080;
		ModernController e; e.SetScreen(W, Hh); e.editing = true;
		HudLayout store[kHudCount]; e.BeginEdit(store, 0);
		auto mid = [](const CtlRect& r, float& cx, float& cy) { cx = (r.l + r.r) / 2; cy = (r.t + r.b) / 2; };
		auto tap = [&](const CtlRect& r) { float x, y; mid(r, x, y); e.OnTouch(2, 1, x, y); e.OnTouch(1, 1, x, y); };
		float cy;
		EditPanel P = e.Panel();
		// geometria: dentro da tela (paisagem e retrato), expandido e recolhido, sem cobrir os controles padrao
		auto inside = [](const EditPanel& q, float w, float h) { return q.box.l >= 0 && q.box.r <= w && q.box.t >= 0 && q.tab.b <= h; };
		CHECK(inside(P, W, Hh)); CHECK(inside(MakeEditPanel(1080, 2400), 1080, 2400)); CHECK(inside(MakeEditPanel(W, Hh, 0, 0, true), W, Hh));
		for (int i = 0; i < B_COUNT; i++) { const CtlCircle& b = e.lay.btn[i]; CHECK(b.cy - b.r > P.tab.b || b.cx + b.r < P.box.l || b.cx - b.r > P.box.r); }
		CHECK(e.lay.base.cy - e.lay.base.r > P.tab.b);
		// todos os itens dentro do painel e sem se sobrepor entre si
		{ const CtlRect* it[] = { &P.exit, &P.hudPrev, &P.hudLbl, &P.hudNext, &P.cloud, &P.share, &P.reset, &P.save, &P.chk, &P.opaTrk, &P.sizeTrk, &P.dpL, &P.dpR, &P.dpU, &P.dpD };
		  const int n = sizeof it / sizeof it[0];
		  for (int i = 0; i < n; i++) { CHECK(it[i]->l >= P.box.l && it[i]->r <= P.box.r && it[i]->t >= P.box.t && it[i]->b <= P.box.b); }
		  for (int i = 0; i < n; i++) for (int j = i + 1; j < n; j++) { const CtlRect &a = *it[i], &b = *it[j]; CHECK(a.r <= b.l || b.r <= a.l || a.b <= b.t || b.b <= a.t); } }
		// selecionar: tocar num botao seleciona; nada de gameplay; som
		CHECK(e.sel == B_ATTACK);
		CHECK(e.OnTouch(2, 1, e.lay.btn[B_JUMP].cx, e.lay.btn[B_JUMP].cy)); CHECK(e.sel == B_JUMP && e.soundReq == 1); CHECK(e.OnTouch(1, 1, 0, 0));
		CHECK(e.Read(false).held == 0);
		CHECK(e.OnTouch(2, 1, e.lay.base.cx, e.lay.base.cy)); CHECK(e.sel == B_COUNT); CHECK(e.OnTouch(1, 1, 0, 0));
		// arrastar mantem o ponto de pegada e marca "alterado"
		{ e.dirty = false; const CtlCircle a = e.lay.btn[B_CROUCH]; const float ox = e.cfg.btnPos[B_CROUCH].x;
		  CHECK(e.OnTouch(2, 1, a.cx + 10, a.cy)); CHECK(e.OnTouch(3, 1, a.cx + 10 + 100, a.cy)); CHECK(e.OnTouch(1, 1, a.cx + 110, a.cy));
		  CHECK(std::fabs(e.cfg.btnPos[B_CROUCH].x - (ox + 100.0f / W)) < 1e-3); CHECK(e.sel == B_CROUCH && e.dirty); }
		// barras: Tamanho e Opacidade do SELECIONADO
		{ e.sel = B_ATTACK; P = e.Panel();
		  cy = (P.sizeTrk.t + P.sizeTrk.b) / 2; CHECK(e.OnTouch(2, 1, P.sizeTrk.l, cy)); CHECK(e.cfg.ctlScale[B_ATTACK] == kScaleMin);
		  e.OnTouch(3, 1, P.sizeTrk.r + 500, cy); CHECK(e.cfg.ctlScale[B_ATTACK] == kScaleMax); e.OnTouch(1, 1, P.sizeTrk.r, cy);
		  CHECK(e.cfg.ctlScale[B_JUMP] == 1.0f);
		  e.sel = B_JUMP; cy = (P.opaTrk.t + P.opaTrk.b) / 2; e.OnTouch(2, 1, P.opaTrk.l, cy); CHECK(e.cfg.ctlAlpha[B_JUMP] == kAlphaMin); e.OnTouch(3, 1, P.opaTrk.r, cy); CHECK(e.cfg.ctlAlpha[B_JUMP] == kAlphaMax); e.OnTouch(1, 1, 0, 0);
		  CHECK(e.cfg.ctlAlpha[B_ATTACK] == 0.55f); }
		// joystick tambem
		{ e.sel = B_COUNT; const float b0 = e.lay.base.r; e.SetSelScale(1.5f); CHECK(e.lay.base.r > b0 * 1.4f); e.SetSelScale(1.0f); }
		// setas de posicao
		{ e.sel = B_RUN; const CtlVec p0 = e.cfg.btnPos[B_RUN]; P = e.Panel();
		  tap(P.dpR); CHECK(std::fabs(e.cfg.btnPos[B_RUN].x - (p0.x + kNudge)) < 1e-5);
		  tap(P.dpL); tap(P.dpL); CHECK(std::fabs(e.cfg.btnPos[B_RUN].x - (p0.x - kNudge)) < 1e-5);
		  tap(P.dpU); CHECK(std::fabs(e.cfg.btnPos[B_RUN].y - (p0.y - kNudge)) < 1e-5);
		  tap(P.dpD); tap(P.dpD); CHECK(std::fabs(e.cfg.btnPos[B_RUN].y - (p0.y + kNudge)) < 1e-5);
		  e.cfg.btnPos[B_RUN] = p0; }
		// sem selecao: barras/setas nao fazem nada
		{ e.sel = -1; const CtlVec p0 = e.cfg.btnPos[B_RUN]; const float s0 = e.cfg.ctlScale[B_RUN]; e.SetSelScale(2.0f); e.Nudge(0.1f, 0.1f); CHECK(e.cfg.ctlScale[B_RUN] == s0 && e.cfg.btnPos[B_RUN].x == p0.x); }
		// Ajuste Inteligente: alinha ao arrastar quando ligado
		{ e.sel = B_JUMP; P = e.Panel(); CHECK(!e.smart); tap(P.chkRow); CHECK(e.smart); P = e.Panel();
		  const CtlVec tgt = e.cfg.btnPos[B_CROUCH]; const CtlCircle a = e.lay.btn[B_JUMP];
		  e.OnTouch(2, 1, a.cx, a.cy); e.OnTouch(3, 1, (tgt.x + 0.006f) * W, (tgt.y - 0.5f) * Hh); e.OnTouch(1, 1, 0, 0);
		  CHECK(std::fabs(e.cfg.btnPos[B_JUMP].x - tgt.x) < 1e-5);                         // alinhou em x
		  tap(P.chkRow); CHECK(!e.smart);
		  e.OnTouch(2, 1, e.lay.btn[B_JUMP].cx, e.lay.btn[B_JUMP].cy); e.OnTouch(3, 1, (tgt.x + 0.006f) * W, (tgt.y - 0.5f) * Hh); e.OnTouch(1, 1, 0, 0);
		  CHECK(std::fabs(e.cfg.btnPos[B_JUMP].x - tgt.x) > 1e-4); }                       // desligado: nao alinha
		// HUD 1..4 independentes
		e.smart = false; e.sel = B_ATTACK; e.cfg.btnPos[B_ATTACK] = { 0.5f, 0.5f }; e.cfg.ctlScale[B_ATTACK] = 1.7f;
		P = e.Panel(); tap(P.hudNext); CHECK(e.hud == 1);
		CHECK(e.cfg.btnPos[B_ATTACK].x == ModernConfig().btnPos[B_ATTACK].x && e.cfg.ctlScale[B_ATTACK] == 1.0f);
		e.cfg.btnPos[B_ATTACK] = { 0.3f, 0.3f };
		tap(P.hudPrev); CHECK(e.hud == 0);
		CHECK(std::fabs(e.cfg.btnPos[B_ATTACK].x - 0.5f) < 1e-4 && e.cfg.ctlScale[B_ATTACK] == 1.7f);
		tap(P.hudPrev); CHECK(e.hud == 3); tap(P.hudNext); CHECK(e.hud == 0);
		// restaurar (reset) so o HUD atual; compartilhar copia o atual para todos
		e.SwitchHud(1); CHECK(std::fabs(e.cfg.btnPos[B_ATTACK].x - 0.3f) < 1e-4); e.SwitchHud(0);
		tap(P.reset); CHECK(e.cfg.btnPos[B_ATTACK].x == ModernConfig().btnPos[B_ATTACK].x && e.cfg.ctlScale[B_ATTACK] == 1.0f);
		e.SwitchHud(1); CHECK(std::fabs(e.cfg.btnPos[B_ATTACK].x - 0.3f) < 1e-4);                                    // HUD 2 intacto
		e.cfg.ctlScale[B_MIC] = 1.3f; tap(P.share);                                                                   // copia o HUD 2 para todos
		e.SwitchHud(3); CHECK(std::fabs(e.cfg.btnPos[B_ATTACK].x - 0.3f) < 1e-4 && e.cfg.ctlScale[B_MIC] == 1.3f); e.SwitchHud(0);
		// salvar so fica ativo se houve alteracao; nuvem = salvar e continuar; sair = descartar
		e.dirty = false; e.editAction = 0; tap(P.save); CHECK(e.editAction == 0);                                    // desativado sem alteracao
		e.dirty = true; tap(P.save); CHECK(e.editAction == 1); e.editAction = 0;
		tap(P.cloud); CHECK(e.editAction == 3); e.editAction = 0;
		tap(P.exit); CHECK(e.editAction == 2 && e.soundReq == 2); e.editAction = 0;
		{ float x, y; mid(P.save, x, y); e.dirty = true; e.OnTouch(2, 1, x, y); e.OnTouch(1, 1, 5, 5); CHECK(e.editAction == 0); }   // soltou fora: nao dispara
		// aba: recolhe / expande; recolhido so tem a linha 1
		{ CHECK(!e.collapsed); tap(P.tab); CHECK(e.collapsed); EditPanel C = e.Panel(); CHECK(C.box.b < P.box.b);
		  const int hudBefore = e.hud; tap(C.hudNext); CHECK(e.hud != hudBefore); tap(C.hudPrev);                       // linha 1 segue funcionando
		  const bool sm = e.smart; float x, y; mid(P.chkRow, x, y); e.OnTouch(2, 1, x, y); e.OnTouch(1, 1, x, y); CHECK(e.smart == sm);   // itens escondidos nao reagem
		  tap(C.tab); CHECK(!e.collapsed); }
		// arrastar o painel pelo fundo: acompanha o dedo e fica sempre inteiro na tela
		{ P = e.Panel(); const float x0 = P.chkRow.r + 5, y0 = (P.hint.t + P.hint.b) / 2;   // fundo vazio
		  e.OnTouch(2, 1, x0, y0); CHECK(e.OnTouch(3, 1, x0 + 300, y0 + 200)); e.OnTouch(1, 1, x0 + 300, y0 + 200);
		  EditPanel M = e.Panel(); CHECK(std::fabs((M.box.l - P.box.l) - 300) < 1.0f && std::fabs((M.box.t - P.box.t) - 200) < 1.0f);
		  CHECK(e.hud == 0 && !e.editAction);                                                                          // arrastar nao aciona nada
		  e.OnTouch(2, 1, M.hint.l + 5, (M.hint.t + M.hint.b) / 2); e.OnTouch(3, 1, -5000, -5000); e.OnTouch(1, 1, -5000, -5000);
		  EditPanel N = e.Panel(); CHECK(inside(N, W, Hh) && N.box.l == 0 && N.box.t == 0);                             // limitado a tela
		  e.OnTouch(2, 1, N.hint.l + 5, (N.hint.t + N.hint.b) / 2); e.OnTouch(3, 1, 99999, 99999); e.OnTouch(1, 1, 99999, 99999);
		  CHECK(inside(e.Panel(), W, Hh)); }
		// o painel nao deixa o toque vazar para o controle de tras; microfone desligado nao e selecionavel
		{ e.panelOx = e.panelOy = 0; P = e.Panel(); e.sel = B_RUN; float x, y; mid(P.hint, x, y); e.OnTouch(2, 1, x, y); e.OnTouch(1, 1, x, y); CHECK(e.sel == B_RUN);
		  e.disabledMask = 1u << B_MIC; e.OnTouch(2, 1, e.lay.btn[B_MIC].cx, e.lay.btn[B_MIC].cy); CHECK(e.sel == B_RUN); e.OnTouch(1, 1, 0, 0); e.disabledMask = 0;
		  // um dedo por vez
		  e.OnTouch(2, 1, e.lay.btn[B_JUMP].cx, e.lay.btn[B_JUMP].cy); CHECK(e.OnTouch(2, 2, e.lay.btn[B_RUN].cx, e.lay.btn[B_RUN].cy) && e.sel == B_JUMP); e.OnTouch(1, 2, 0, 0); e.OnTouch(1, 1, 0, 0); }
		// HudLayout <-> config / clamps
		ModernConfig q; q.btnPos[B_MIC] = { 0.2f, 0.2f }; q.ctlAlpha[B_MIC] = 0.9f; HudLayout hl = ExtractLayout(q); ModernConfig q2; ApplyLayout(q2, hl);
		CHECK(q2.btnPos[B_MIC].x == 0.2f && q2.ctlAlpha[B_MIC] == 0.9f);
		ModernConfig bad; bad.ctlScale[0] = 99; bad.ctlAlpha[1] = -3; bad.ctlScale[2] = NAN; bad.Clamp(); CHECK(bad.ctlScale[0] == 2.0f && bad.ctlAlpha[1] == 0.15f && bad.ctlScale[2] == 1.0f);
		CHECK(ClampHud(-5) == 0 && ClampHud(9) == 3);
	}

	// --- mira arrastavel ---
	{
		AimDrag a; a.SetScreen(2400, 1080); AimEv ev[4];
		CHECK(a.Move(10, 10, ev) == 0);                                  // sem Begin: nada
		int n = a.Begin(2160, 734, ev); CHECK(n == 1 && ev[0].type == 2 && ev[0].x > 0 && ev[0].x < 2400);   // push na ancora
		const float ax = ev[0].x, ay = ev[0].y;
		n = a.Move(2160, 734, ev); CHECK(n == 0);                         // parado: nenhum evento (so delta, nao absoluto)
		n = a.Move(2200, 734, ev); CHECK(n == 1 && ev[0].type == 3 && std::fabs(ev[0].x - (ax + 40)) < 1e-3 && std::fabs(ev[0].y - ay) < 1e-3);
		n = a.Move(2200, 700, ev); CHECK(n == 1 && std::fabs(ev[0].y - (ay - 34)) < 1e-3);      // vertical -> vertical
		a.sens = 2.0f; n = a.Move(2210, 700, ev); CHECK(n == 1 && std::fabs(ev[0].x - (ax + 40 + 20)) < 1e-3);   // sensibilidade
		n = a.End(ev); CHECK(n == 1 && ev[0].type == 1 && !a.active());   // soltar encerra
		CHECK(a.End(ev) == 0 && a.Move(1, 1, ev) == 0);
		// reancora: arrasto longo nunca sai da tela e o jogo ve sempre push/move/pop validos
		AimDrag b; b.SetScreen(2400, 1080); b.Begin(2000, 700, ev); bool ok = true; float x = 2000; int pushes = 1, pops = 0;
		for (int i = 0; i < 400; i++) { x += 12; int k = b.Move(x, 700, ev); for (int j = 0; j < k; j++) { if (ev[j].x < 0 || ev[j].x > 2400 || ev[j].y < 0 || ev[j].y > 1080) ok = false; if (ev[j].type == 2) pushes++; if (ev[j].type == 1) pops++; } }
		CHECK(ok); CHECK(pushes == pops + 1 && pushes > 1);
		// suavizacao: movimento unico e distribuido ao longo dos eventos; total nao passa do arrastado
		AimDrag c; c.SetScreen(2400, 1080); c.smooth = 0.5f; c.Begin(2000, 700, ev); float tot = 0; float lastx = 0;
		c.Move(2100, 700, ev); lastx = ev[0].x; const float firstStep = lastx - 1392; for (int i = 0; i < 20; i++) { int k = c.Move(2100, 700, ev); if (k) { tot += ev[k - 1].x - lastx; lastx = ev[k - 1].x; } }
		CHECK(firstStep > 0 && firstStep < 100 && tot > 0 && tot <= 100.0f);
		ModernConfig d; d.aimSens = 99; d.aimSmooth = 5; d.Clamp(); CHECK(d.aimSens == 3.0f && d.aimSmooth == 0.85f && d.aimDrag);
	}

	// --- seletor ---
	for (int orient = 0; orient < 2; orient++)
	{
		const float sw = orient ? 1080 : 2400, sh = orient ? 2400 : 1080;
		SelectorLayout S = MakeSelectorLayout(sw, sh);
		CHECK(S.card[0].r <= S.card[1].l || S.card[0].b <= S.card[1].t);     // cartoes nao se sobrepoem
		for (int i = 0; i < 2; i++) { CHECK(S.card[i].l >= 0 && S.card[i].r <= sw && S.card[i].t >= 0 && S.card[i].b <= sh); CHECK(CtlIn(S.card[i], (S.selectBtn[i].l + S.selectBtn[i].r) / 2, (S.selectBtn[i].t + S.selectBtn[i].b) / 2)); }
		CHECK(S.confirm.r <= sw && S.back.l >= 0 && S.back.r <= S.confirm.l);
		SelectorState st; st.Open(Mode::Classic);
		auto mid = [](const CtlRect& r, float& cx, float& cy) { cx = (r.l + r.r) / 2; cy = (r.t + r.b) / 2; };
		float cx, cy;
		mid(S.selectBtn[1], cx, cy); st.Act(SelectorHit(S, cx, cy)); CHECK(st.selected == Mode::Modern && !st.done);
		mid(S.back, cx, cy); st.Act(SelectorHit(S, cx, cy)); CHECK(st.done && !st.apply && st.current == Mode::Classic);   // VOLTAR nao aplica
		st.Open(Mode::Classic);
		mid(S.card[1], cx, cy); st.Act(SelectorHit(S, cx, cy)); mid(S.confirm, cx, cy); st.Act(SelectorHit(S, cx, cy));
		CHECK(st.done && st.apply && st.selected == Mode::Modern);
		CHECK(SelectorHit(S, 1, 1) == SelAction::None || !CtlIn(S.panel, 1, 1) == false);
	}

	// --- auto exibicao / modo efetivo ---
	CHECK(ShouldAutoShowSelector(false, true, false));
	CHECK(!ShouldAutoShowSelector(true, true, false));      // ja escolheu: nunca de novo
	CHECK(!ShouldAutoShowSelector(false, false, false));    // fora do jogo (login/conexao)
	CHECK(!ShouldAutoShowSelector(false, true, true));      // sobre dialogo/teclado/spawn
	CHECK(!ModernActiveOnFoot(Mode::Classic, false, false, true));
	CHECK(ModernActiveOnFoot(Mode::Modern, false, false, true));
	CHECK(!ModernActiveOnFoot(Mode::Modern, true, false, true));
	CHECK(!ModernActiveOnFoot(Mode::Modern, false, true, true));
	CHECK(!ModernActiveOnFoot(Mode::Modern, false, false, false));

	// --- Safe Zone (MakeLayout com margem) ---
	{
		ModernConfig c; const float W = 2400, H = 1080;
		ModernLayout a = MakeLayout(c, W, H), z = MakeLayout(c, W, H, 0.0f, 0.0f), s = MakeLayout(c, W, H, 120.0f, 54.0f);
		CHECK(a.base.cx == z.base.cx && a.base.cy == z.base.cy && a.btn[B_ATTACK].cx == z.btn[B_ATTACK].cx);   // margem 0 = layout identico
		CHECK(s.base.r == a.base.r && s.btn[B_ATTACK].r == a.btn[B_ATTACK].r);                                 // tamanho nao muda
		CHECK(s.base.cx > a.base.cx && s.base.cy < a.base.cy);                                                  // esquerda/baixo: anda para dentro
		CHECK(s.btn[B_ATTACK].cx < a.btn[B_ATTACK].cx);                                                         // direita: anda para a esquerda
		for (int i = 0; i < B_COUNT; i++) { CHECK(s.btn[i].cx >= 120.0f - 1.0f && s.btn[i].cx <= W - 120.0f + 1.0f); CHECK(s.btn[i].cy >= 54.0f - 1.0f && s.btn[i].cy <= H - 54.0f + 1.0f); }
		ModernController mc; mc.SetScreen(W, H); const float x0 = mc.lay.base.cx; mc.SetInsets(120.0f, 54.0f); CHECK(mc.lay.base.cx > x0);
		mc.editing = true; mc.SetScreen(W, H); CHECK(mc.lay.base.cx == x0);                                      // editor ignora a Safe Zone
	}
	printf("%d/%d verificacoes OK\n", total - fails, total);
	return fails ? 1 : 0;
}

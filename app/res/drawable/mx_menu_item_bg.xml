<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="@color/mx_menu_selected" /><corners android:radius="10dp" /></shape></item>
            <item android:left="0dp" android:right="0dp"><shape android:shape="rectangle"><stroke android:width="1dp" android:color="@color/mx_cyan" /><corners android:radius="10dp" /></shape></item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#2222B8FF" /><corners android:radius="10dp" /></shape>
    </item>
    <item><shape android:shape="rectangle"><solid android:color="@android:color/transparent" /><corners android:radius="10dp" /></shape></item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF1565FF" android:endColor="#FF1E90FF"/>
            <stroke android:width="1dp" android:color="#8856B3FF"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#33265FD0"/><corners android:radius="10dp"/></shape>
    </item>
    <item><shape android:shape="rectangle"><solid android:color="#00000000"/><corners android:radius="10dp"/></shape></item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#44265FD0" />
            <stroke android:width="2dp" android:color="#FF35C2FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#FF0A1736" android:startColor="#FF162A57" />
            <stroke android:width="2dp" android:color="#AA2B8BFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>

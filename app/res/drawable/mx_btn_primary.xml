<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="#44455A80" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#FF0B6FD6" android:endColor="#FF0A55A8" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#FF35C2FF" android:endColor="#FF0B6FD6" /><corners android:radius="10dp" /></shape>
    </item>
</selector>

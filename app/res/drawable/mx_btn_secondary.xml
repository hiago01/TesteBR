<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="#22455A80" /><stroke android:width="1dp" android:color="#44455A80" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#3322B8FF" /><stroke android:width="1dp" android:color="@color/mx_cyan" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#14000000" /><stroke android:width="1dp" android:color="@color/mx_cyan" /><corners android:radius="10dp" /></shape>
    </item>
</selector>
